{
  "name": "Ecommerce BI Theme",
  "dataColors": [
    "#1B3A6B",
    "#3498DB",
    "#2ECC71",
    "#F39C12",
    "#E74C3C",
    "#8E44AD",
    "#1ABC9C",
    "#E67E22"
  ],
  "background": "#FFFFFF",
  "foreground": "#2C3E50",
  "tableAccent": "#3498DB",
  "good": "#27AE60",
  "neutral": "#F39C12",
  "bad": "#E74C3C",
  "maximum": "#1B3A6B",
  "center": "#3498DB",
  "minimum": "#EBF5FB",
  "null": "#BDC3C7",
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [{ "value": "Segoe UI" }],
        "fontSize": [{ "value": 11 }]
      }
    },
    "card": {
      "*": {
        "calloutValue": [{ "fontSize": 28, "fontFamily": "Segoe UI Semibold" }],
        "label": [{ "fontSize": 11 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FAFAFA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E5E5E5" } } }]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#2C3E50" } }, "fontSize": 10 }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#ECF0F1" } }, "gridlineThickness": 1 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1B3A6B" } }, "textSize": 12 }],
        "items": [{ "fontColor": { "solid": { "color": "#2C3E50" } }, "textSize": 11 }]
      }
    }
  }
}
